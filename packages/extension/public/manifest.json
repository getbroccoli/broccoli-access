{
  "manifest_version": 3,
  "name": "Broccoli Access",
  "version": "1.0",
  "description": "Pairs this Chrome with your Broccoli Access, to hand over your session in an app when you connect it.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Broccoli Access"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "optional_permissions": ["cookies", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["installed.txt", "pair.html", "handOver.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'"
  }
}
